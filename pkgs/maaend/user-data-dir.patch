+// UserDataDir returns the shared user data directory, falling back to StartupDir
+// when PI_USER_DATA_DIR is absent. Callers must check its error during startup.
+func UserDataDir() (string, error) {
+	return userDataDir, userDataDirErr
+}
+
+// OutputPath joins relative path components under the shared user data directory.
+// Callers must check UserDataDir's error before using output paths.
 func OutputPath(parts ...string) string {
-	if startupDirErr != nil {
