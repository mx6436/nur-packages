-// Resolve persistent output against the startup directory, not the executable.
+// Resolve the shared user data directory once, before initializing persistent output.
+// Older Clients do not inject PI_USER_DATA_DIR; retain the portable layout for them.
+inline const std::filesystem::path& UserDataDir()
+{
+    static const std::filesystem::path user_data_dir = [] {
+#ifdef _WIN32
+        wchar_t* buffer = nullptr;
+        size_t size = 0;
+        if (_wdupenv_s(&buffer, &size, L"PI_USER_DATA_DIR") != 0) {
+            throw std::runtime_error("Failed to read PI_USER_DATA_DIR");
+        }
+        const std::unique_ptr<wchar_t, decltype(&std::free)> value(buffer, &std::free);
+        const auto dir = buffer && *buffer ? std::filesystem::path(buffer) : StartupDir();
+#else
+        const char* value = std::getenv("PI_USER_DATA_DIR");
+        const auto dir = value && *value ? MAA_NS::path(value) : StartupDir();
+#endif
+        if (!dir.is_absolute()) {
+            throw std::runtime_error("PI_USER_DATA_DIR must be an absolute path");
+        }
+        return dir.lexically_normal();
+    }();
+    return user_data_dir;
+}
+
+// Resolve persistent output against the shared user data directory, not resources.
 inline std::filesystem::path OutputPath(const std::filesystem::path& relative_path = {})
 {
-    return relative_path.empty() ? StartupDir() : StartupDir() / relative_path;
+    return relative_path.empty() ? UserDataDir() : UserDataDir() / relative_path;
 }
 
