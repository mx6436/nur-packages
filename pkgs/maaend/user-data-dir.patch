@@ -1,11 +1,25 @@
 package fsutil
 
 import (
+	"fmt"
 	"os"
 	"path/filepath"
+
+	"github.com/MaaXYZ/MaaEnd/agent/go-service/pkg/pienv"
 )
 
 var startupDir, startupDirErr = os.Getwd()
+var userDataDir, userDataDirErr = resolveUserDataDir(os.Getenv(pienv.EnvUserDataDir))
+
+func resolveUserDataDir(dir string) (string, error) {
+	if dir == "" {
+		return startupDir, startupDirErr
+	}
+	if !filepath.IsAbs(dir) {
+		return "", fmt.Errorf("%s must be an absolute path: %q", pienv.EnvUserDataDir, dir)
+	}
+	return filepath.Clean(dir), nil
+}
 
 // StartupDir returns the working directory captured during process startup.
 // An error means output paths cannot be resolved and startup must be aborted.
@@ -13,11 +27,17 @@ func StartupDir() (string, error) {
