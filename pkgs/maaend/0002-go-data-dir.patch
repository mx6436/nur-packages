+func getMxuDataDir() string {
+	xdgDataHome := os.Getenv("XDG_DATA_HOME")
+	if xdgDataHome != "" {
+		return filepath.Join(xdgDataHome, "MXU")
+	}
+
+	homeDir, err := os.UserHomeDir()
+	if err != nil || homeDir == "" {
+		return "."
+	}
+
+	return filepath.Join(homeDir, ".local", "share", "MXU")
+}
+
+func getDebugDir() string {
+	return filepath.Join(getMxuDataDir(), "debug")
+}
+
 func initLogger() (*os.File, error) {
-	debugDir := filepath.Join(".", "debug")
+	debugDir := getDebugDir()
