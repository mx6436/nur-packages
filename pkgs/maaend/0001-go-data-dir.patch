+		return filepath.Join(xdgDataHome, "MXU")
+	}
+
+	homeDir, err := os.UserHomeDir()
+	if err != nil || homeDir == "" {
+		return "."
+	}
+
+	return filepath.Join(homeDir, ".local", "share", "MXU")
+}
