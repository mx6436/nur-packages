+std::filesystem::path get_picli_data_path()
+{
+    if (const char* xdg_data_home = std::getenv("XDG_DATA_HOME");
+        xdg_data_home != nullptr && xdg_data_home[0] != '\0') {
+        return std::filesystem::path(xdg_data_home) / "MaaPiCli";
+    }
+
+    if (const char* home = std::getenv("HOME"); home != nullptr && home[0] != '\0') {
+        return std::filesystem::path(home) / ".local" / "share" / "MaaPiCli";
+    }
+
+    return std::filesystem::current_path() / "MaaPiCli";
+}
+
+std::filesystem::path get_resource_path(char* argv0)
+{
+    if (argv0 == nullptr || argv0[0] == '\0') {
+        return MAA_NS::library_dir();
+    }
+
+    std::error_code ec;
+    std::filesystem::path exe_path = std::filesystem::absolute(argv0, ec);
+    if (ec) {
+        return MAA_NS::library_dir();
+    }
+
+    exe_path = std::filesystem::weakly_canonical(exe_path, ec);
+    if (ec) {
+        return MAA_NS::library_dir();
+    }
+
+    return exe_path.parent_path();
+}
+
 int main(int argc, char** argv)
 {
